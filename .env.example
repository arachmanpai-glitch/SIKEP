# =============================================================================
# SIKEP - Environment Configuration Template
# Salin file ini menjadi .env dan isi sesuai environment lokal/deployment.
# JANGAN PERNAH commit file .env yang berisi nilai asli.
# =============================================================================

# --- App ---
NODE_ENV=development
APP_URL=http://localhost:3000
APP_TIMEZONE=Asia/Jakarta

# --- Database (PostgreSQL, wajib NUMERIC(18,2) untuk kolom uang) ---
DATABASE_URL="postgresql://user:password@localhost:5432/sikep?schema=public"

# --- Auth (diisi lengkap pada PHASE 3 - AUTH + RBAC) ---
AUTH_SECRET=

# --- Object Storage (S3-compatible, diisi lengkap pada PHASE 6/9) ---
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# --- SMTP / Transactional Email (diisi lengkap pada PHASE 8/9) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="SIKEP <noreply@sikep.local>"

# --- Logging ---
LOG_LEVEL=info
